# Servidor & Entorno
PORT=3000
NODE_ENV=production

# Base de Datos Persistente Real (PostgreSQL) — Obligatoria al iniciar
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/lavueltasessions

# Secreto Criptográfico Permanente para Firma HMAC-SHA256 de Tickets QR (32 bytes hex)
QR_HMAC_SECRET=CHANGE_ME_TO_32_BYTE_RANDOM_HEX_IN_PRODUCTION

# Proveedor de Correo Transaccional (Opcional - Resend API)
RESEND_API_KEY=
EMAIL_FROM="LA VUELTA SESSIONS <entradas@lavueltasessions.com>"

# Clave API para App Móvil Externa LB Validador (Opcional)
LB_VALIDADOR_API_KEY=

# Orígenes CORS Adicionales Permitidos (Separados por coma)
ALLOWED_ORIGINS=
